{
  "name": "runlens",
  "version": "0.1.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Priyadharshan0903/Runlens.git"
  },
  "homepage": "https://github.com/Priyadharshan0903/Runlens#readme",
  "bugs": {
    "url": "https://github.com/Priyadharshan0903/Runlens/issues"
  },
  "description": "Inspect local Claude Code and Codex sessions, subagents and tool calls.",
  "type": "module",
  "bin": {
    "runlens": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/cli.js",
    "dev": "node scripts/build.mjs && node dist/cli.js",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "node scripts/build-site.mjs --serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && vitest run tests/core.test.ts tests/features.test.ts tests/projects.test.ts tests/sources.test.ts tests/codex.test.ts tests/mcp.test.ts tests/mcp-protocol.test.ts && npm run build",
    "check:ci": "npm run format:check && npm run typecheck && npm test && npm run build",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@phosphor-icons/react": "2.1.10",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1",
    "preact": "^11.0.1",
    "prettier": "3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
