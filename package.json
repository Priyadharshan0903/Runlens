{
  "name": "runlens",
  "version": "0.1.0",
  "private": true,
  "description": "See what your Claude Code agents actually did: a local, visual trace of sessions, subagents and tool calls.",
  "type": "module",
  "bin": {
    "runlens": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/cli.js",
    "dev": "node scripts/build.mjs && node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && vitest run tests/core.test.ts tests/features.test.ts && npm run build"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1",
    "preact": "^11.0.1",
    "prettier": "3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
